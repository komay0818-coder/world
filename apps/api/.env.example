# Only local and dev are accepted by this phase.
APP_ENV=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# The hostname must be explicitly listed and the database name must not contain
# prod, production, or live. Add a Dev Supabase pooler host when needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lorn_dev
DATABASE_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_SSL=false

# Dev Supabase project values. Never place the secret/service-role key here.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
