# Only local and dev are accepted by this phase.
APP_ENV=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# The hostname must be explicitly listed and the database name must not contain
# prod, production, or live. Add a Dev Supabase pooler host when needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lorn_dev
DATABASE_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_SSL=false
# Required when DATABASE_SSL=true; keep the certificate outside the repository.
DATABASE_CA_CERT_PATH=
# Pin the confirmed lorn-dev project ref before migrations are allowed.
LORN_DEV_SUPABASE_PROJECT_REF=

# Dev Supabase project values. Never place the secret/service-role key here.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Exact local browser origins allowed to call the development API.
FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:8771,http://localhost:8771
# Optional outside Render. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_API_BASE_URL=
